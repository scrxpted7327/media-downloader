# Obtain this from @BotFather. Do not commit the real value.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram IDs. At least one of these lists must be set.
# A private-chat user is allowed only when their user ID is listed here.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Comma-separated numeric chat/channel IDs (channels usually start with -100).
# Channel posts are allowed only when the channel ID is listed here.
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890

# Optional destination for errors reported by supervisor.py. Defaults to the
# first TELEGRAM_ALLOWED_CHAT_IDS entry, then the first allowed user ID.
TELEGRAM_ERROR_CHAT_ID=

# Local Telegram Bot API server URL (e.g. http://localhost:8081).
# Raises upload limit from 50 MB to ~2 GB. Leave empty to use the public API.
TELEGRAM_LOCAL_API_URL=

# Where the external yt-dlp executable is installed. It is downloaded on startup
# when absent or out of date; it is not shipped with this application.
MEDIA_BOT_TOOLS_DIR=~/.local/share/media-downloader/tools

# LaMa inpainting defaults to CPU for predictable behavior. Set this to an
# installed ONNX Runtime provider name to opt into an accelerator.
MEDIA_BOT_ONNX_PROVIDER=CPUExecutionProvider

# Optional pinned yt-dlp release tag. Empty means the latest GitHub release.
YTDLP_VERSION=

# Bound resource usage before a download begins.
MEDIA_BOT_MAX_FILESIZE_MB=47
MEDIA_BOT_DOWNLOAD_TIMEOUT_SECONDS=3600
MEDIA_BOT_UPLOAD_TIMEOUT_SECONDS=900

# Persistent storage for downloaded files and the SQLite database.
MEDIA_BOT_STORAGE_DIR=runtime/jobs
MEDIA_BOT_DB_PATH=runtime/jobs/media-bot.db

# Secure download link settings (used when Cloudflare Tunnel is configured).
# The tunnel should route MEDIA_BOT_DOWNLOAD_DOMAIN to this bot's download port.
MEDIA_BOT_DOWNLOAD_DOMAIN=media.scrxpted.cc
MEDIA_BOT_DOWNLOAD_PORT=8080

# Token expiry in minutes for one-time secure download links.
MEDIA_BOT_TOKEN_EXPIRY_MINUTES=15

# Retention in days before uploaded jobs and files are cleaned up.
MEDIA_BOT_RETENTION_DAYS=7

# Remote transcription (offloads CPU-heavy faster-whisper to a more powerful machine).
# Set to user@host to stream audio over SSH for transcription on the remote server.
# The remote machine needs python3 with faster-whisper installed.
WHISPER_SSH_HOST=
# Optional SSH key path for the remote transcription host.
WHISPER_SSH_KEY=
